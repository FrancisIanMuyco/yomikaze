{
  "name": "yomikaze",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "YOMIKAZE — Read. Discover. Escape. A modern Manga + Manhua discovery and reading platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && npm run juku:typecheck",
    "generate:demo": "node scripts/generate-demo-pages.mjs",
    "juku": "tsc -p juku/tsconfig.json && node juku/dist/cli.js",
    "juku:build": "tsc -p juku/tsconfig.json",
    "juku:typecheck": "tsc -p juku/tsconfig.json --noEmit",
    "juku:search": "npm run juku -- search",
    "juku:import": "npm run juku -- import",
    "juku:update": "npm run juku -- update",
    "juku:health": "npm run juku -- health",
    "juku:proxies": "npm run juku -- proxies",
    "juku:scheduler": "npm run juku -- scheduler",
    "juku:status": "npm run juku -- status"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}

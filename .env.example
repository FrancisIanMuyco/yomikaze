# ============================================================
# YOMIKAZE — Environment variables
# Copy this file to `.env` and adjust as needed.
# No private secrets are used by YOMIKAZE. Never put API keys
# in VITE_* variables — this project has none.
# ============================================================

# Content provider: mangadex | auto | anilist | demo | mock
#   mangadex → MangaDex official API — real metadata + REAL chapter pages (default)
#   auto     → MangaDex + original demo reader content (offline fallback)
#   anilist  → AniList metadata only (chapters show "unavailable")
#   demo     → Fully offline: 3 original demo titles with working reader pages
#   mock     → Fully offline: small built-in metadata set (no reader pages)
VITE_CONTENT_PROVIDER=mangadex

# MangaDex official public API (no key required for public reads)
VITE_MANGADEX_ENDPOINT=https://api.mangadex.org

# Cover image base. Networks that block uploads.mangadex.org can point this at
# the Cloudflare Worker proxy instead:
#   VITE_MANGADEX_ENDPOINT=https://<worker>.workers.dev/md
#   VITE_MANGADEX_COVER_ENDPOINT=https://<worker>.workers.dev/covers
VITE_MANGADEX_COVER_ENDPOINT=https://uploads.mangadex.org/covers

# Per-request timeout for MangaDex (milliseconds)
VITE_MANGADEX_TIMEOUT_MS=15000

# AniList GraphQL endpoint (only used when provider=anilist)
VITE_ANILIST_ENDPOINT=https://graphql.anilist.co
VITE_ANILIST_TIMEOUT_MS=15000

# In-memory cache TTL for API responses (milliseconds)
VITE_API_CACHE_TTL_MS=300000
